# Use production on server deployment (e.g Render) to enable secure cookies
NODE_ENV=development
PORT=3000

# MongoDB connection string.
MONGO_URI=

# JWT signing key.
JWT_KEY=

# Set this to the frontend origin for credentialed browser requests.
FRONTEND_URL=http://localhost:5173

# Set this to the public server URL to enable 10-minute health checks.
# Leave empty to disable keep-alive checks locally.
DEPLOYED_URL=
